{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "amrit-vedham",
  "main": "worker.js",
  "compatibility_date": "2026-11-03",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "observability": {
    "enabled": true
  }
}
